{
  "name": "Quillmark",
  "version": "1.0.0",
  "color": {
    "light": {
      "surface":  { "value": "#F5F1E8", "role": "ground" },
      "raised":   { "value": "#FBF9F4", "role": "one tone step up: sheets, panels" },
      "ink":      { "value": "#16201C", "role": "text and strongest marks" },
      "muted":    { "value": "#55605A", "role": "secondary text" },
      "brand":    { "value": "#1D4A40", "role": "action, headline ink, colour fields" },
      "onBrand":  { "value": "#F7F3EA", "role": "text on brand" },
      "hairline": { "value": "#D8D0BE", "role": "form fields, tables, product fragments only" },
      "brass":    { "value": "#B8893A", "role": "small fills only, never text on light" },
      "control":  { "value": "#868B82", "role": "control borders" },
      "error":    { "value": "#9B2C1F", "role": "error text" }
    },
    "dark": {
      "surface":  { "value": "#0E1412" },
      "raised":   { "value": "#151C19" },
      "ink":      { "value": "#EEE8DA" },
      "muted":    { "value": "#A6AEA8" },
      "brand":    { "value": "#86BCAB" },
      "onBrand":  { "value": "#0E1412" },
      "hairline": { "value": "#2C3632" },
      "brass":    { "value": "#D6AB5A" },
      "control":  { "value": "#6B756F" },
      "error":    { "value": "#F0A595" }
    }
  },
  "font": {
    "display": { "family": "Newsreader", "weights": [400, 500], "use": "headlines, wordmark, letters" },
    "text":    { "family": "Hanken Grotesk", "weights": [400, 500, 600], "use": "interface and running text" },
    "figures": { "family": "Geist Mono", "weights": [400], "use": "figures only: prices, metrics, dates in data" }
  },
  "size": { "small": "14px", "body": "18px", "mid": "clamp(24px, 2.2vw, 32px)", "large": "clamp(40px, 4.4vw, 64px)", "figure": "clamp(128px, 17vw, 248px)" },
  "radius": { "control": "6px", "panel": "10px", "stage": "16px" },
  "space": { "margin": "clamp(16px, 2.2vw, 32px)", "gap": "12px", "section": "clamp(96px, 9.5vw, 144px)" },
  "motion": {
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeMove": "cubic-bezier(0.65, 0, 0.35, 1)",
    "hover": "220ms", "small": "380ms", "reveal": "820ms", "picture": "1600ms", "stagger": "75ms"
  }
}
