{
  "name": "Quillmarc",
  "version": "3.0.0",
  "color": {
    "light": {
      "ivory": {
        "value": "#FAF7EF",
        "role": "ground"
      },
      "raised": {
        "value": "#FFFDF8",
        "role": "cards and sheets"
      },
      "midnightNavy": {
        "value": "#102542",
        "role": "ink and stage fields"
      },
      "muted": {
        "value": "#4A5A72",
        "role": "secondary text"
      },
      "sapphire": {
        "value": "#1E3A5F",
        "role": "actions and links"
      },
      "onAccent": {
        "value": "#FAF8F5"
      },
      "champagne": {
        "value": "#D8C3A5",
        "role": "tints and highlights, never text on light"
      },
      "hairline": {
        "value": "#E8DFD0"
      },
      "brass": {
        "value": "#DDB040",
        "role": "Gilt gold: the full stop and fills; text or buttons on navy only"
      },
      "control": {
        "value": "#8790A0",
        "role": "control borders"
      },
      "error": {
        "value": "#9B2C1F"
      },
      "stage": {
        "value": "#102542"
      }
    },
    "dark": {
      "ivory": {
        "value": "#0A1628"
      },
      "raised": {
        "value": "#102542"
      },
      "midnightNavy": {
        "value": "#FAF8F5"
      },
      "muted": {
        "value": "#A8B3C4"
      },
      "sapphire": {
        "value": "#DDB040"
      },
      "onAccent": {
        "value": "#102542"
      },
      "champagne": {
        "value": "#D8C3A5"
      },
      "hairline": {
        "value": "#22385A"
      },
      "brass": {
        "value": "#DDB040"
      },
      "control": {
        "value": "#6B7C96"
      },
      "error": {
        "value": "#F0A595"
      },
      "stage": {
        "value": "#1E3A5F"
      }
    }
  },
  "font": {
    "display": {
      "family": "Newsreader",
      "weights": [
        400,
        500
      ],
      "use": "headlines, wordmark, letters"
    },
    "text": {
      "family": "Hanken Grotesk",
      "weights": [
        400,
        500,
        600
      ],
      "use": "interface and running text"
    },
    "figures": {
      "family": "Geist Mono",
      "weights": [
        400
      ],
      "use": "figures only: prices, metrics, dates in data"
    }
  },
  "size": {
    "small": "14px",
    "body": "18px",
    "mid": "clamp(24px, 2.2vw, 32px)",
    "large": "clamp(40px, 4.4vw, 64px)",
    "figure": "clamp(128px, 17vw, 248px)"
  },
  "radius": {
    "control": "6px",
    "panel": "10px",
    "stage": "16px"
  },
  "space": {
    "margin": "clamp(16px, 2.2vw, 32px)",
    "gap": "12px",
    "section": "clamp(96px, 9.5vw, 144px)"
  },
  "motion": {
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeMove": "cubic-bezier(0.65, 0, 0.35, 1)",
    "hover": "220ms",
    "small": "380ms",
    "reveal": "820ms",
    "picture": "1600ms",
    "stagger": "75ms"
  }
}
