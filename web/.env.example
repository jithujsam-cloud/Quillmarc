# Quillmarc app environment variables. Copy to .env.local for local work and set the same
# names in Vercel (Project, Settings, Environment Variables). Never commit real values.
# REQUIRED means the app will not start a flow that needs it without it.

# REQUIRED. Supabase project URL, from Project Settings, API. Example: https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# REQUIRED. Supabase anon (public) key, from the same page. Safe to expose; row level security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# REQUIRED. Supabase service role key. SERVER ONLY. Bypasses row level security. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED. 32 random bytes as 64 hex characters, used to encrypt Stripe keys (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Changing it later makes stored Stripe keys unreadable; founders would need to reconnect.
ENCRYPTION_KEY=

# REQUIRED to send real email. Resend API key with sending access, from resend.com.
RESEND_API_KEY=
# REQUIRED to receive delivery events. The signing secret of your Resend webhook (starts with whsec_).
RESEND_WEBHOOK_SECRET=
# REQUIRED. The domain verified in Resend that email is sent from, for example updates.klaroh.com.
# Email goes out as "Founder name via Quillmarc <updates@SENDING_DOMAIN>".
SENDING_DOMAIN=

# REQUIRED. Public address of this app, no trailing slash. Used in magic links, email links and hosted pages.
# Example: https://app.yourdomain.com or http://localhost:3000
APP_URL=
# REQUIRED. Shown on the privacy and terms pages for questions and deletion requests.
CONTACT_EMAIL=

# OPTIONAL. Stripe Connect ("Connect with Stripe" button). Both must be set to show the button;
# without them founders paste a restricted key instead. From your Stripe account (the platform):
# Connect, Settings, Onboarding options, OAuth: turn OAuth on, copy the client id (ca_...), and add
# <APP_URL>/api/stripe/callback as a redirect URI. Use the test-mode client id and sk_test_ key to try it.
STRIPE_CONNECT_CLIENT_ID=
# SERVER ONLY. Your platform's secret key (sk_live_ or sk_test_). Used only to complete Connect and
# to read connected accounts, which Stripe limits to read only.
STRIPE_SECRET_KEY=

# OPTIONAL. Set to "resend" to send real email. Anything else, or unset, uses the mock provider,
# which records emails in memory and sends nothing. Tests never set it.
EMAIL_PROVIDER=mock

# OPTIONAL. Your email (or several, comma-separated). These accounts see the Accounts page at
# /admin, where you activate, extend or end each founder's access.
ADMIN_EMAILS=
# OPTIONAL. Where "Continue with Quillmarc" goes when a free trial ends: a payment link from
# Razorpay, Lemon Squeezy, Paddle or anything else. When unset, it opens an email to CONTACT_EMAIL.
BILLING_URL=

# OPTIONAL, seed script only. The email of the demo founder account `npm run seed` creates.
SEED_USER_EMAIL=
