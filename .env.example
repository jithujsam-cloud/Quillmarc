# Quillmarc environment variables.
# Set these in Vercel: Project, Settings, Environment Variables. For local work, copy this
# file to .env.local and run `node scripts/dev.js`. Never commit real values.

# ---- Required for signups to save ----------------------------------------------------
# Supabase project URL, for example https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase service role key (Project Settings, API). Server only. Never expose it in the
# browser. Without SUPABASE_URL and this key, the form shows a friendly error and saves nothing.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Recommended ------------------------------------------------------------------------
# Canonical site address, no trailing slash. Used in emails and the share link.
# Default: https://quillmarc.vercel.app
SITE_URL=https://quillmarc.vercel.app
# Address for replies and data deletion requests. Shown on the privacy and terms pages,
# used as reply-to on the welcome email, and shown in form error messages.
CONTACT_EMAIL=
# Random secret used to hash visitor IPs for rate limiting. Any long random string.
IP_HASH_SALT=

# ---- Optional: welcome email (skipped silently when either is unset) -------------------
# Resend API key, from resend.com. The sending domain must be verified in Resend.
RESEND_API_KEY=
# From address on a domain verified in Resend, for example: Jithu at Quillmarc <jithu@quillmarc.com>
RESEND_FROM=

# ---- Optional: thank-you page ----------------------------------------------------------
# 15 minute booking link (Cal.com, Calendly, Google Calendar). The call block is hidden when unset.
BOOKING_URL=

# ---- Optional: founder photo -----------------------------------------------------------
# Square photo URL for the "Who is building this" block, for example /assets/founder.jpg.
# When unset, a monogram is shown instead.
FOUNDER_PHOTO_URL=

# ---- Optional: analytics ---------------------------------------------------------------
# Plausible site domain, for example quillmarc.vercel.app. Analytics loads only when set.
# Tracked events: Form Start, Signup, Extra Answer, Call Click (plus page views).
PLAUSIBLE_DOMAIN=
# Plausible script URL. The default supports custom events.
PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

# ---- Optional: headline test -----------------------------------------------------------
# "on" (default) splits visitors 50/50 between two headlines, sticky per browser, and stores
# the variant (a or b) on each signup. "off" shows headline A to everyone.
HEADLINE_TEST=on

# ---- Testing only ----------------------------------------------------------------------
# Override the Resend API base URL (used to point at a local mock in tests). Leave unset.
RESEND_API_URL=
